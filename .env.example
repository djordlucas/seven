# Copy to .env. `npm start` and compose.yaml both read it.

# Mistral API key. MISTRAL_API_KEY is accepted too.
SEVEN_LLM_API_KEY=

# Any Mistral chat model with function calling.
# SEVEN_LLM_MODEL=mistral-medium-latest
# SEVEN_LLM_ENDPOINT=https://api.mistral.ai/v1

# The directory seven works in. All of its data lives there, under .seven/.
# SEVEN_WORKSPACE=.

# SEVEN_MAX_STEPS=40
# SEVEN_RUN_TIMEOUT_MS=60000
# SEVEN_RUN_MEMORY_MB=1024
# SEVEN_MAX_AGENTS=16
# SEVEN_LLM_CONCURRENCY=4

# Logging: debug | info | warn | error. The file is relative to the workspace;
# "off" writes none. SEVEN_LOG_STDERR=1 also logs to stderr (on for `seven serve`).
# SEVEN_LOG_LEVEL=info
# SEVEN_LOG_FILE=.seven/logs/seven.log
# SEVEN_LOG_STDERR=0

# Copy to .env and set your key. seven reads .env from the current directory
# (without overriding real environment variables); compose passes it via env_file.

# Mistral API key. MISTRAL_API_KEY is accepted too.
SEVEN_LLM_API_KEY=

# Any Mistral chat model with function calling.
# SEVEN_LLM_MODEL=mistral-medium-latest
# SEVEN_LLM_ENDPOINT=https://api.mistral.ai/v1

# The directory seven works in. All of its data lives there, under .seven/.
# SEVEN_WORKSPACE=.

# SEVEN_MAX_STEPS=40
# The model's context window, in tokens; conversations are compacted to fit it.
# SEVEN_CONTEXT_TOKENS=128000
# SEVEN_RUN_TIMEOUT_MS=60000
# SEVEN_RUN_MEMORY_MB=1024
# SEVEN_MAX_AGENTS=16
# SEVEN_LLM_CONCURRENCY=4
# Tool results longer than this are spilled to SEVEN_MEMORY_DIR and read back in
# chunks with read_memory, instead of entering the conversation whole. 0 disables.
# SEVEN_SPILL_CHARS=2000
# SEVEN_MEMORY_DIR=.seven/memory
# Set to 0 to send every tool schema on every step instead of core + discovered.
# SEVEN_TOOL_DISCOVERY=1
# SEVEN_DELEGATE_TIMEOUT_S=600
# SEVEN_LOG_LEVEL=info
